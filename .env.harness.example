# MobileIoT test harness secrets.
# Copy to .env.harness (gitignored) and fill in. Values can also be supplied via environment
# variables; env takes precedence over the file.

# Azure IoT Operations / IoT Hub
AZURE_IOT_CONNSTR=

# WiFi Direct + camera ingest
IOTOPS_MEDIA_CONNECTOR_INGEST_URL=
IOTOPS_MEDIA_CONNECTOR_STREAM_ID=
IOTOPS_MEDIA_CONNECTOR_API_KEY=

# Provisioning over NFC
WIFI_SSID=
WIFI_PSK=

# Pi SSH (USB-gadget link)
PI_SSH_KEY_PATH=
