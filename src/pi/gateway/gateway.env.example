# MobileIoT OPC UA Gateway — environment configuration
# Copy to /etc/mobileiot/gateway.env and adjust values.

# Path to YAML config file
GATEWAY_CONFIG=/etc/mobileiot/gateway.yaml

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
GATEWAY_LOG_LEVEL=INFO

# Azure IoT Operations settings (used by onboarding scripts)
AIO_RESOURCE_GROUP=my-resource-group
AIO_INSTANCE_NAME=my-aio-instance
AIO_DEVICE_NAME=mobileiot-gateway
