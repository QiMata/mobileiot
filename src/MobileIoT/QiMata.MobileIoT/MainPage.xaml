<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QiMata.MobileIoT.Controls"
             x:Class="QiMata.MobileIoT.MainPage"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VerticalStackLayout>
            <Image Source="dotnet_bot.png"
                   HeightRequest="150"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,10"/>

            <controls:PageHeader Title="QiMata Mobile IoT" />
            <controls:FeatureDescription Text="Launchpad for each demo. Tap a tile to open the feature page." />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12" Margin="20">
                    <Button Text="Bluetooth LE"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="BlePage" />

                    <Button Text="BLE Beacons"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="BleScannerPage" />

                    <Button Text="NFC"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="NfcPage" />

                    <Button Text="NFC Peer-to-Peer"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="NfcP2PPage" />

                    <Button Text="USB"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="UsbPage" />

                    <Button Text="Serial"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="SerialPage" />

                    <Button Text="Wi-Fi Direct"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="WifiDirectPage" />

                    <Button Text="Audio Jack"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="AudioPage" />

                    <Button Text="Computer Vision"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="VisionPage" />

                    <Button Text="NFC Provisioning"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="NfcProvisioningPage" />

                    <Button Text="Thread"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="ThreadPage" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
