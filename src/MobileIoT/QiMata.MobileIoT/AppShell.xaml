<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="QiMata.MobileIoT.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QiMata.MobileIoT"
    Shell.FlyoutBehavior="Disabled"
    Title="QiMata.MobileIoT">

    <Shell.TitleView>
        <Border
            BackgroundColor="{StaticResource BrandRed}"
            HeightRequest="28"
            Padding="8,0"
            IsVisible="{x:Static local:App.IsMockMode}"
            VerticalOptions="Center">
            <Label
                Text="MOCK MODE — services are simulated"
                TextColor="White"
                FontSize="13"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />
        </Border>
    </Shell.TitleView>

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
