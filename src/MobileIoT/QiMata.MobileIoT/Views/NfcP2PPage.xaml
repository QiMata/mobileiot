<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QiMata.MobileIoT.Controls"
             x:Class="QiMata.MobileIoT.Views.NfcP2PPage"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Title="NFC Peer-to-Peer">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="NFC Peer-to-Peer" />

        <Frame Grid.Row="1" Style="{StaticResource CardFrame}">
            <VerticalStackLayout Spacing="20">
                <Button Text="Tap phones to exchange"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartP2PCommand}" />

                <controls:BackButton Command="{Binding NavigateBackCommand}" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
