<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QiMata.MobileIoT.Controls"
             x:Class="QiMata.MobileIoT.Views.ThreadPage"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Title="Thread Demo">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <VerticalStackLayout>
            <controls:PageHeader Title="Thread Protocol Demo" />
            <controls:FeatureDescription Text="Queries Thread mesh status via the Pi OTBR bridge and runs CoAP echo pings. Starts in mock mode; toggle 'Use Live Bridge' for real data." />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="16">

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Use Live Bridge"
                               FontSize="16"
                               TextColor="{StaticResource HeaderText}"
                               VerticalOptions="Center"/>
                        <Switch IsToggled="{Binding UseLiveBridge}"
                                OnColor="{StaticResource BrandGreen}"/>
                    </HorizontalStackLayout>

                    <Label Text="Bridge URL"
                           Style="{StaticResource MutedLabel}"/>
                    <Entry Text="{Binding BridgeUrl}"
                           Placeholder="http://raspberrypi.local:8080"
                           Keyboard="Url"/>

                    <Label Text="Target Node"
                           Style="{StaticResource MutedLabel}"/>
                    <Entry Text="{Binding TargetNode}"
                           Placeholder="mesh-local IPv6 address"/>

                    <Label Text="Ping Payload"
                           Style="{StaticResource MutedLabel}"/>
                    <Entry Text="{Binding Payload}"
                           Placeholder="ping"/>

                    <Button Text="Refresh Status"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshStatusCommand}" />

                    <Button Text="Send CoAP Ping"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding SendPingCommand}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource BrandBlue}"
                                       HorizontalOptions="Center"/>

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="Thread Status"
                           Style="{StaticResource SectionHeaderLabel}"/>

                    <Label Text="{Binding Role, StringFormat='Role: {0}'}"
                           FontSize="16"
                           TextColor="{StaticResource BodyText}"/>

                    <Label Text="{Binding Rloc16, StringFormat='RLOC16: {0}'}"
                           FontSize="16"
                           TextColor="{StaticResource BodyText}"/>

                    <Label Text="{Binding MeshAddresses, StringFormat='Mesh Addresses: {0}'}"
                           FontSize="14"
                           TextColor="{StaticResource BodyText}"/>

                    <Label Text="{Binding SourceMode, StringFormat='Source: {0}'}"
                           Style="{StaticResource MutedLabel}"/>

                    <Label Text="Dataset (hex):"
                           Style="{StaticResource MutedLabel}"/>
                    <Label Text="{Binding DatasetHex}"
                           FontSize="12"
                           TextColor="{StaticResource BodyText}"
                           LineBreakMode="CharacterWrap"/>

                    <BoxView Style="{StaticResource DividerLine}" />

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Log"
                               Style="{StaticResource SectionHeaderLabel}"
                               VerticalOptions="Center"/>
                        <Button Text="Clear"
                                Style="{StaticResource DangerButton}"
                                HeightRequest="32"
                                Padding="10,0"
                                FontSize="12"
                                Command="{Binding ClearLogCommand}" />
                    </HorizontalStackLayout>

                    <Editor Text="{Binding LogText}"
                            IsReadOnly="True"
                            HeightRequest="200"
                            FontFamily="Courier New"
                            FontSize="11"/>

                    <controls:BackButton Command="{Binding NavigateBackCommand}" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
