<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QiMata.MobileIoT.Controls"
             x:Class="QiMata.MobileIoT.Views.BlePage"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Title="BLE Sensor &amp; LED">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <VerticalStackLayout>
            <controls:PageHeader Title="BLE Sensor &amp; LED Control" />
            <controls:FeatureDescription Text="Streams DHT22 sensor readings from a Pi over BLE GATT and toggles an LED characteristic." />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="20">
                    <Button Text="{Binding ConnectButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ToggleConnectionCommand}" />

                    <Label Text="{Binding ConnectionStatus}"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}"
                           HorizontalOptions="Center" />

                    <Label Text="DHT22 Sensor"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <Label Text="{Binding Temperature, StringFormat='Temperature: {0} °C'}"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}"/>

                    <Label Text="{Binding Humidity, StringFormat='Humidity: {0}%'}"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}"/>

                    <Button Text="Refresh Sensor"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshSensorCommand}" />

                    <Button Text="{Binding StreamButtonText}"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding ToggleStreamingCommand}" />

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="LED Control"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <Button Text="{Binding LedButtonText}"
                            BackgroundColor="{Binding LedButtonColor}"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding ToggleLedCommand}" />

                    <Label Text="{Binding LedStatus}"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}"
                           HorizontalOptions="Center"
                           Margin="0,10"/>

                    <controls:BackButton Command="{Binding NavigateBackCommand}" />
                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
