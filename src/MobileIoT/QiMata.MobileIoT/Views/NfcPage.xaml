<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QiMata.MobileIoT.Controls"
             x:Class="QiMata.MobileIoT.Views.NfcPage"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Title="NFC">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Title="NFC Tag Reader / Writer" />

        <ScrollView Grid.Row="1">
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="20">

                    <Label Text="{Binding StatusMessage}"
                           TextColor="{StaticResource BrandRed}"
                           FontSize="14" />

                    <Label Text="Last Tag Content:"
                           Style="{StaticResource SectionHeaderLabel}"/>
                    <Label Text="{Binding TagContent}"
                           FontSize="18"
                           LineBreakMode="WordWrap"/>

                    <Button Text="{Binding ListenButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ToggleListenCommand}"/>

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="Write Tag"
                           Style="{StaticResource SectionHeaderLabel}"/>
                    <Entry Placeholder="Text to write"
                           Text="{Binding TextToWrite}"/>
                    <Button Text="Write to Tag"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding WriteCommand}"/>

                    <controls:BackButton Command="{Binding NavigateBackCommand}" />
                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
