<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QiMata.MobileIoT.Controls"
             xmlns:vm="clr-namespace:QiMata.MobileIoT.ViewModels"
             x:Class="QiMata.MobileIoT.Views.BleScannerPage"
             Title="BLE Beacons"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"   />
        </Grid.RowDefinitions>

        <VerticalStackLayout>
            <controls:PageHeader Title="Detected BLE Beacons" />
            <controls:FeatureDescription Text="Scans for nearby BLE advertisers; tap a result to inspect services." />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Devices}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BeaconItemViewModel">
                    <Frame Margin="0,6"
                           Padding="12"
                           CornerRadius="8"
                           BackgroundColor="White"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name, FallbackValue=(no name)}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{StaticResource BodyText}"/>
                            <Label Text="{Binding DeviceId}"
                                   FontSize="12"
                                   TextColor="{StaticResource BrandGray}"/>
                            <Label Text="{Binding Rssi, StringFormat='RSSI: {0} dBm'}"
                                   FontSize="14"
                                   TextColor="{StaticResource HeaderText}"/>
                            <Label Text="{Binding DataPreview}"
                                   FontFamily="Courier New"
                                   FontSize="12"
                                   TextColor="{StaticResource BrandBlue}"/>
                            <VerticalStackLayout IsVisible="{Binding IsTelemetryBeacon}" Spacing="2">
                                <Label Text="{Binding DecodedTemp, StringFormat='Temp: {0:F1} °C'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource BrandGreen}"/>
                                <Label Text="{Binding DecodedHumidity, StringFormat='Humidity: {0:F1}%'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource BrandGreen}"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
