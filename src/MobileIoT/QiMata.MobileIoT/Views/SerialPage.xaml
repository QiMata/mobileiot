<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QiMata.MobileIoT.Controls"
             x:Class="QiMata.MobileIoT.Views.SerialPage"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Title="Serial Console">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Serial Console" />

        <ScrollView Grid.Row="1">
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="16">

                    <Button Text="{Binding ConnectButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConnectAsyncCommand}" />

                    <Label Text="{Binding ConnectionStatus}"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}"
                           HorizontalOptions="Center" />

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="LED Control"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <HorizontalStackLayout Spacing="12">
                        <Button Text="LED ON"
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding SendLedOnAsyncCommand}" />
                        <Button Text="LED OFF"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding SendLedOffAsyncCommand}" />
                    </HorizontalStackLayout>

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="GPIO"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <HorizontalStackLayout Spacing="8">
                        <Entry Placeholder="Pin"
                               Text="{Binding GpioPin}"
                               Keyboard="Numeric"
                               WidthRequest="60" />
                        <Button Text="Read"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendGpioReadAsyncCommand}" />
                        <Entry Placeholder="Val"
                               Text="{Binding GpioValue}"
                               Keyboard="Numeric"
                               WidthRequest="50" />
                        <Button Text="Write"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendGpioWriteAsyncCommand}" />
                    </HorizontalStackLayout>

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="DHT22 Sensor"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <Button Text="Read Sensor"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendSensorReadAsyncCommand}" />

                    <Label Text="{Binding LastSensorTemp, StringFormat='Temperature: {0} °C'}"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}" />

                    <Label Text="{Binding LastSensorHum, StringFormat='Humidity: {0}%'}"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}" />

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="System Status"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <Button Text="Pi Status"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendStatusAsyncCommand}" />

                    <Label Text="{Binding PiStatus}"
                           FontSize="16"
                           TextColor="{StaticResource BodyText}" />

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="Log"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <Editor Text="{Binding Log}"
                            IsReadOnly="True"
                            HeightRequest="150"
                            FontFamily="Courier New"
                            FontSize="12" />

                    <controls:BackButton Command="{Binding NavigateBackCommand}" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
