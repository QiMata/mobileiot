<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QiMata.MobileIoT.Views.SerialPage"
             BackgroundColor="#F3F4F6"
             Title="Serial Console">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Label Text="Serial Console"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#374151"
               HorizontalOptions="Center"
               Margin="0,20"/>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <Frame BackgroundColor="White"
                   CornerRadius="10"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="16">

                    <!-- Connect -->
                    <Button Text="{Binding ConnectButtonText}"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding ConnectAsyncCommand}" />

                    <Label Text="{Binding ConnectionStatus}"
                           FontSize="18"
                           TextColor="#111827"
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,10"/>

                    <!-- LED Control -->
                    <Label Text="LED Control"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <HorizontalStackLayout Spacing="12">
                        <Button Text="LED ON"
                                BackgroundColor="#059669"
                                TextColor="White"
                                CornerRadius="8"
                                Command="{Binding SendLedOnAsyncCommand}" />
                        <Button Text="LED OFF"
                                BackgroundColor="#DC2626"
                                TextColor="White"
                                CornerRadius="8"
                                Command="{Binding SendLedOffAsyncCommand}" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,10"/>

                    <!-- GPIO -->
                    <Label Text="GPIO"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <HorizontalStackLayout Spacing="8">
                        <Entry Placeholder="Pin"
                               Text="{Binding GpioPin}"
                               Keyboard="Numeric"
                               WidthRequest="60" />
                        <Button Text="Read"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                CornerRadius="8"
                                Command="{Binding SendGpioReadAsyncCommand}" />
                        <Entry Placeholder="Val"
                               Text="{Binding GpioValue}"
                               Keyboard="Numeric"
                               WidthRequest="50" />
                        <Button Text="Write"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                CornerRadius="8"
                                Command="{Binding SendGpioWriteAsyncCommand}" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,10"/>

                    <!-- Sensor -->
                    <Label Text="DHT22 Sensor"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Button Text="Read Sensor"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding SendSensorReadAsyncCommand}" />

                    <Label Text="{Binding LastSensorTemp, StringFormat='Temperature: {0} °C'}"
                           FontSize="18"
                           TextColor="#111827" />

                    <Label Text="{Binding LastSensorHum, StringFormat='Humidity: {0}%'}"
                           FontSize="18"
                           TextColor="#111827" />

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,10"/>

                    <!-- Status -->
                    <Label Text="System Status"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Button Text="Pi Status"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding SendStatusAsyncCommand}" />

                    <Label Text="{Binding PiStatus}"
                           FontSize="16"
                           TextColor="#111827" />

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,10"/>

                    <!-- Log -->
                    <Label Text="Log"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Editor Text="{Binding Log}"
                            IsReadOnly="True"
                            HeightRequest="150"
                            FontFamily="Courier New"
                            FontSize="12" />

                    <!-- Back -->
                    <Button Text="Back"
                            BackgroundColor="#6B7280"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding NavigateBackCommand}" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
