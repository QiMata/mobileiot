<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QiMata.MobileIoT.Controls"
             x:Class="QiMata.MobileIoT.Views.NfcProvisioningPage"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Title="NFC Provisioning">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Title="NFC Device Provisioning" />

        <ScrollView Grid.Row="1">
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Wi-Fi Configuration"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <Entry Placeholder="SSID"
                           Text="{Binding WifiSsid}" />

                    <Entry Placeholder="Password"
                           Text="{Binding WifiPassword}"
                           IsPassword="True" />

                    <Picker Title="Security"
                            ItemsSource="{Binding SecurityOptions}"
                            SelectedItem="{Binding WifiSecurity}" />

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="Device Configuration"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <Entry Placeholder="Device Name"
                           Text="{Binding DeviceName}" />

                    <Entry Placeholder="MQTT Broker IP"
                           Text="{Binding MqttBroker}" />

                    <Entry Placeholder="MQTT Port"
                           Text="{Binding MqttPort}"
                           Keyboard="Numeric" />

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Button Text="Write to NFC Tag"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding WriteProvisioningTagAsyncCommand}" />

                    <Label Text="{Binding ProvisionStatus}"
                           FontSize="18"
                           TextColor="#111827"
                           HorizontalOptions="Center" />

                    <controls:BackButton Command="{Binding NavigateBackCommand}" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
