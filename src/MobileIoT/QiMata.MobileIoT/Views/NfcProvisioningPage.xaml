<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QiMata.MobileIoT.Views.NfcProvisioningPage"
             BackgroundColor="#F3F4F6"
             Title="NFC Provisioning">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Label Text="NFC Device Provisioning"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#374151"
               HorizontalOptions="Center"
               Margin="0,20"/>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <Frame BackgroundColor="White"
                   CornerRadius="10"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="16">

                    <!-- Wi-Fi Config -->
                    <Label Text="Wi-Fi Configuration"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Entry Placeholder="SSID"
                           Text="{Binding WifiSsid}" />

                    <Entry Placeholder="Password"
                           Text="{Binding WifiPassword}"
                           IsPassword="True" />

                    <Picker Title="Security"
                            ItemsSource="{Binding SecurityOptions}"
                            SelectedItem="{Binding WifiSecurity}" />

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,10"/>

                    <!-- Device Config -->
                    <Label Text="Device Configuration"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Entry Placeholder="Device Name"
                           Text="{Binding DeviceName}" />

                    <Entry Placeholder="MQTT Broker IP"
                           Text="{Binding MqttBroker}" />

                    <Entry Placeholder="MQTT Port"
                           Text="{Binding MqttPort}"
                           Keyboard="Numeric" />

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,10"/>

                    <!-- Write -->
                    <Button Text="Write to NFC Tag"
                            BackgroundColor="#059669"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding WriteProvisioningTagAsyncCommand}" />

                    <Label Text="{Binding ProvisionStatus}"
                           FontSize="18"
                           TextColor="#111827"
                           HorizontalOptions="Center" />

                    <!-- Back -->
                    <Button Text="Back"
                            BackgroundColor="#6B7280"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding NavigateBackCommand}" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
