<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QiMata.MobileIoT.Controls"
             x:Class="QiMata.MobileIoT.Views.VisionPage"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Title="Computer Vision">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <VerticalStackLayout>
            <controls:PageHeader Title="Computer Vision" />
            <controls:FeatureDescription Text="Pulls JPEG frames from the Pi camera HTTP endpoint and renders a live preview." />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Local Camera"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Scan QR Code"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScanQrCommand}" />
                        <Button Text="Capture Photo"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding CapturePhotoCommand}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding QrResult}"
                           FontSize="16"
                           TextColor="{StaticResource BodyText}" />

                    <Image Source="{Binding Photo}" HeightRequest="200" />

                    <Label Text="{Binding Result}"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}" />

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="Pi Camera"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <HorizontalStackLayout Spacing="8">
                        <Entry Placeholder="Pi address"
                               Text="{Binding PiAddress}"
                               WidthRequest="200" />
                        <Button Text="Check"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding CheckPiConnectionCommand}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding PiStatus}"
                           Style="{StaticResource MutedLabel}" />

                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Capture Frame"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding CapturePiFrameCommand}" />
                        <Button Text="Classify on Pi"
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding ClassifyOnPiCommand}" />
                    </HorizontalStackLayout>

                    <Image Source="{Binding PiPhoto}" HeightRequest="200" />

                    <Label Text="{Binding PiCameraResult}"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}" />

                    <BoxView Style="{StaticResource DividerLine}" />

                    <controls:BackButton Command="{Binding NavigateBackCommand}" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
