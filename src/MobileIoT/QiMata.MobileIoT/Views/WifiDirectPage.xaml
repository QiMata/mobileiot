<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QiMata.MobileIoT.Models;assembly=QiMata.MobileIoT.Shared"
             x:Class="QiMata.MobileIoT.Views.WifiDirectPage"
             BackgroundColor="#F3F4F6"
             Title="Wi-Fi Direct">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Label Text="Wi-Fi Direct"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#374151"
               HorizontalOptions="Center"
               Margin="0,20"/>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <Frame BackgroundColor="White"
                   CornerRadius="10"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="16">

                    <!-- Connect -->
                    <Button Text="{Binding ConnectButtonText}"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding DiscoverAsyncCommand}" />

                    <Label Text="{Binding ConnectionStatus}"
                           FontSize="18"
                           TextColor="#111827"
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,10"/>

                    <!-- Telemetry -->
                    <Label Text="Telemetry"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Button Text="{Binding StreamButtonText}"
                            BackgroundColor="#059669"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding ToggleStreamAsyncCommand}" />

                    <Label Text="{Binding Temperature, StringFormat='Temperature: {0:F1} °C'}"
                           FontSize="18"
                           TextColor="#111827" />

                    <Label Text="{Binding Humidity, StringFormat='Humidity: {0:F1}%'}"
                           FontSize="18"
                           TextColor="#111827" />

                    <Label Text="{Binding CpuTemp, StringFormat='CPU Temp: {0:F1} °C'}"
                           FontSize="18"
                           TextColor="#111827" />

                    <Label Text="{Binding Uptime, StringFormat='Uptime: {0}'}"
                           FontSize="18"
                           TextColor="#111827" />

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,10"/>

                    <!-- File Browser -->
                    <Label Text="File Browser"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Button Text="List Files"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding RequestFileListAsyncCommand}" />

                    <CollectionView ItemsSource="{Binding Files}"
                                    HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RemoteFileInfo">
                                <HorizontalStackLayout Spacing="8" Padding="4">
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           TextColor="#111827"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Size, StringFormat='({0} bytes)'}"
                                           FontSize="12"
                                           TextColor="#6B7280"
                                           VerticalOptions="Center" />
                                    <Button Text="Download"
                                            BackgroundColor="#2563EB"
                                            TextColor="White"
                                            CornerRadius="6"
                                            FontSize="12"
                                            Padding="8,4"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DownloadFileAsyncCommand}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,10"/>

                    <!-- Log -->
                    <Label Text="Log"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Editor Text="{Binding Log}"
                            IsReadOnly="True"
                            HeightRequest="150"
                            FontFamily="Courier New"
                            FontSize="12" />

                    <!-- Back -->
                    <Button Text="Back"
                            BackgroundColor="#6B7280"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding NavigateBackCommand}" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
