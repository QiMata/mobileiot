<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QiMata.MobileIoT.Controls"
             xmlns:models="clr-namespace:QiMata.MobileIoT.Models;assembly=QiMata.MobileIoT.Shared"
             x:Class="QiMata.MobileIoT.Views.WifiDirectPage"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Title="Wi-Fi Direct">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Wi-Fi Direct" />

        <ScrollView Grid.Row="1">
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="16">

                    <Button Text="{Binding ConnectButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding DiscoverAsyncCommand}" />

                    <Label Text="{Binding ConnectionStatus}"
                           FontSize="18"
                           TextColor="#111827"
                           HorizontalOptions="Center" />

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="Telemetry"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <Button Text="{Binding StreamButtonText}"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding ToggleStreamAsyncCommand}" />

                    <Label Text="{Binding Temperature, StringFormat='Temperature: {0:F1} °C'}"
                           FontSize="18"
                           TextColor="#111827" />

                    <Label Text="{Binding Humidity, StringFormat='Humidity: {0:F1}%'}"
                           FontSize="18"
                           TextColor="#111827" />

                    <Label Text="{Binding CpuTemp, StringFormat='CPU Temp: {0:F1} °C'}"
                           FontSize="18"
                           TextColor="#111827" />

                    <Label Text="{Binding Uptime, StringFormat='Uptime: {0}'}"
                           FontSize="18"
                           TextColor="#111827" />

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="File Browser"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <Button Text="List Files"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RequestFileListAsyncCommand}" />

                    <CollectionView ItemsSource="{Binding Files}"
                                    HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RemoteFileInfo">
                                <HorizontalStackLayout Spacing="8" Padding="4">
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           TextColor="#111827"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Size, StringFormat='({0} bytes)'}"
                                           FontSize="12"
                                           TextColor="{StaticResource BrandGray}"
                                           VerticalOptions="Center" />
                                    <Button Text="Download"
                                            Style="{StaticResource PrimaryButton}"
                                            FontSize="12"
                                            Padding="8,4"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DownloadFileAsyncCommand}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView Style="{StaticResource DividerLine}" />

                    <Label Text="Log"
                           Style="{StaticResource SectionHeaderLabel}" />

                    <Editor Text="{Binding Log}"
                            IsReadOnly="True"
                            HeightRequest="150"
                            FontFamily="Courier New"
                            FontSize="12" />

                    <controls:BackButton Command="{Binding NavigateBackCommand}" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
